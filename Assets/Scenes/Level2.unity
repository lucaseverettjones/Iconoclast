      objectReference: {fileID: 2100000, guid: 9e57c5718744f70488918e18a6566718, type: 2}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: characterName
      value: Runaway Orilla
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: myPlayerController
