        type: 3}
      propertyPath: interactionText.Array.data[0]
      value: "I\u2019ve been trying to escape for months."
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[1]
      value: I managed to dig a tunnel through here, only...
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[2]
