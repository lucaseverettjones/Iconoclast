        type: 3}
      propertyPath: ambientText.Array.data[0]
      value: 'This boulder is harder than other rocks, somehow. '
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[1]
      value: "It\u2019s like I don\u2019t have the right tool for the job. "
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[2]
      value: My plan foiled, just like that!
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
