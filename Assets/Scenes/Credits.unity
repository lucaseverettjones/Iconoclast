      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[0]
      value: So close, and yet so far...
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[1]
      value: They really made it hard to escape.
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[2]
      value: 'If only there was some way to cross safely... '
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[0]
      value: "I got so close, but now I\u2019m stuck! "
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[1]
      value: 'I try to cross, but the ground crumbles and I fall! '
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[2]
      value: "I just don\u2019t get it...how do I get past? "
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[3]
      value: 'He downed 6 glasses of Skavo before I cut him off. '
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[4]
      value: 'He downed 6 glasses of Skavo before I cut him off. '
      objectReference: {fileID: 0}
