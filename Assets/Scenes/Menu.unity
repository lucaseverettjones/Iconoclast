  m_Script: {fileID: 11500000, guid: 2fb0e2da9fb14ed4dbaba572442ec851, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionText:
  - '    They''re going to recycle me, I know they are. '
  - '    Worst of all, it was their work that made it happen. '
  - '    Quarrying stone and clay so they can make more slaves. '
  - '    Curse it all! Is this how I get repaid? '
  ambientText:
  - 'Augh! It still hurts! '
  - 'Why did this have to happen? '
  - 'Argh, curse this pain. '
  aggroText: 
  isHostile: 0
  isDrunk: 0
  myPlayerController: {fileID: 0}
  characterName: Injured Orilla
  speechClips: []
  aggroClips: []
  drunkClips: []
