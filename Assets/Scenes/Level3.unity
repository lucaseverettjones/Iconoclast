      value: 
      objectReference: {fileID: 2100000, guid: 17d40264b1dceaf4f8f81882f5221447, type: 2}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: characterName
      value: Fleeing Orilla
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[0]
      value: "It\u2019s so frightening to be outside."
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[1]
      value: "I\u2019m confused, I don\u2019t know what to do. "
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[2]
      value: "I\u2019m fine here, I just need to steel myself."
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[0]
      value: 'I got past the guards, but it was close. '
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[1]
      value: "I don\u2019t know how to open the door to escape. "
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[2]
      value: "I\u2019m hiding from the guards, just for a little while."
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[3]
      value: "Yes, I\u2019ll try again later! I just need a minute. "
      objectReference: {fileID: 0}
    - target: {fileID: 8555671458291981936, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: m_Name
      value: Maididle (2)
      objectReference: {fileID: 0}
    - target: {fileID: 8555671458291981936, guid: 52475fba9cab45943b067a3e3b3311d6,
