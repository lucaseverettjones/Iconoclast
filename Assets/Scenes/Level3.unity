    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[0]
      value: "There\u2019s something strange about this garden. "
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[1]
      value: 'Maybe I should try to escape...no, what am I saying? '
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[2]
      value: 'Do they really think we are too foolish to escape? '
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[0]
      value: "Hey, it\u2019s you again! Thanks for breaking that rock. "
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[1]
      value: The guards are patrolling the corners of the garden.
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
