--- !u!1001 &1151882688
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1667537824}
    m_Modifications:
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: characterName
      value: Rude Gardener
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[0]
      value: "They don\u2019t understand me, none of them do. "
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[1]
      value: Curse these weeds! They have no respect at all
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[2]
      value: 'This garden is the only place where no one bothers me. '
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[0]
      value: "Leave me alone, can\u2019t you see I\u2019m busy? "
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[1]
      value: 'Escaping? What a foolish notion! '
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: interactionText.Array.data[2]
      value: "I\u2019d report you, but I don\u2019t have the time. "
      objectReference: {fileID: 0}
    - target: {fileID: 8555671458291981936, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: m_Name
