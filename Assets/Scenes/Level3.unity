        type: 3}
      propertyPath: ambientText.Array.data[0]
      value: "Gardening isn\u2019t so bad. There are much worse jobs."
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[1]
      value: 'Augh, nothing but weeds, weeds, and more weeds. '
      objectReference: {fileID: 0}
    - target: {fileID: 8550755460390450786, guid: 52475fba9cab45943b067a3e3b3311d6,
        type: 3}
      propertyPath: ambientText.Array.data[2]
      value: 'Hello, little flower. How are you today? '
      objectReference: {fileID: 0}
